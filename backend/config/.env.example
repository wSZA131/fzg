# AI provider: qwen | deepseek
AI_PROVIDER=qwen
USE_REAL_AI=true

# Qwen config
QWEN_API_KEY=your_qwen_api_key
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL_NAME=qwen-plus

# DeepSeek config (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL_NAME=deepseek-chat

# OCR
OCR_PROVIDER=mock
QWEN_VL_MODEL_NAME=qwen-vl-plus

# Open learning resources (official APIs only)
# Wikipedia + Wikibooks need no key; YouTube requires an official Data API v3 key.
WIKIPEDIA_LANGUAGES=zh
OPEN_TEXTBOOKS_ENABLED=1
OPENSTAX_ENABLED=1
OPENSTAX_CATALOG_TTL_SECONDS=86400
OAK_API_KEY=
SERPAPI_API_KEY=
SERPAPI_ENGINES=google_scholar,google_books,google_videos,google_play_books
SERPAPI_MAX_QUERIES=2
YOUTUBE_API_KEY=
OPEN_RESOURCE_TIMEOUT_SECONDS=1.8
OPEN_RESOURCE_CACHE_TTL_SECONDS=21600
OPEN_RESOURCE_MAX_QUERIES=4

# Storage
STORAGE_BACKEND=sql
DATABASE_URL=sqlite:///data/fzg.db

# Neo4j (optional)
USE_NEO4J=auto
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=<username>
NEO4J_PASSWORD=<password>
NEO4J_DATABASE=<database>

# Celery + Redis (optional)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 安全与运行时（生产必须显式配置）
# BACKEND_DEBUG=false
# CORS_ALLOWED_ORIGINS=https://your-domain.example
# 评测接口默认关闭，需要时再开启
# AGENT_EVAL_ENABLED=false
# AGENT_EVAL_TOKEN=
