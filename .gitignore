# Python cache
__pycache__/
*.py[cod]
*.pyo
*.cpython-*.py

# Virtual environments
venv/
.venv/
backend/venv/

# Local environment and secrets
.env
*.env
backend/.env
*credentials*.csv

# Editor settings
.vscode/
.idea/

# Logs
*.log
push.log
backend/logs/*.log
frontend/logs/*.log

# OS files
.DS_Store
Thumbs.db

# 参赛材料与办公文档：含个人信息，不入库
*.docx
*.doc
*.xlsx
*.pptx

# Database files
backend/data/fzg.db
database/*.db
dump.rdb
backend/dump.rdb

# Runtime data and local artifacts
backend/run/*.pid
.run/
.logs/

# ==========================================================
# backend/data 使用白名单：默认全部忽略，只放行明确需要的资产。
#
# 这里曾经是逐条列出用户名的黑名单，管线从未覆盖到
# auth_users.json（密码哈希）、auth_sessions.json（会话）与
# 邮箱账号的学习记录，导致这些数据被提交进仓库。
# 黑名单永远会漏，白名单才是可控的。
# ==========================================================
backend/data/*
!backend/data/pro_kb/
!backend/data/pro_kb/**
!backend/data/concept_stopwords.json
!backend/data/question_bank_official_ai.json
