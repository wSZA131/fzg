# ==========================================================
# 低配模式环境变量（2 核 2G / 40 GB 系统盘，如 Flexus L 2C2G2M）
# 使用方式：
#   cp .env.lite.example .env
#   填好 QWEN_API_KEY 与 FLASK_SECRET_KEY
#   bash deploy.sh
#
# 与完整版的差异：
#   - 构建时 LITE_MODE=true：不装 torch 与 BGE 模型，镜像约 400 MB
#   - 检索走 TF-IDF + FAISS，仍覆盖完整知识库，只是没有语义向量
#   - 不启用 Redis / Celery，会话历史用进程内存
#   - 上传与日志体积收紧，避免撑爆 40 GB 磁盘
# ==========================================================

# ---------- 构建参数 ----------
LITE_MODE=true
PREFETCH_EMBEDDING_MODEL=false
PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple

# ---------- 大模型（MaaS / 兼容 OpenAI 接口） ----------
USE_REAL_AI=true
AI_PROVIDER=qwen
QWEN_API_KEY=
QWEN_API_URL=https://<maas-endpoint>/v1/chat/completions
QWEN_MODEL_NAME=qwen-plus

# 低配下减少重试，避免一次故障放大成多次模型调用
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_RETRIES=0
AGENT_ENABLE_GUARD=true

# ---------- 会话历史（不启用 Redis，走进程内存） ----------
AGENT_HISTORY_BACKEND=memory
AGENT_MEMORY_SESSION_LIMIT=200

# ---------- 存储（SQLite，接 RDS 时改 sql） ----------
STORAGE_BACKEND=json
SPACE_STORAGE_BACKEND=sql
# 接入 RDS 后改为：
# STORAGE_BACKEND=sql
# DATABASE_URL=mysql+pymysql://user:pass@<rds-internal-host>:3306/fzg?charset=utf8mb4

# ---------- 知识库 ----------
# 保持 true：TF-IDF 编码 + FAISS 检索仍可用（faiss-cpu 已装）
KB_PUBLIC_VECTOR_ENABLED=true
KB_PRIVATE_VECTOR_ENABLED=true
# 低配不加载 BGE，留空即回退到 pro_kb_tfidf_vectorizer.pkl
KB_PUBLIC_VECTOR_MODEL=

# ---------- 知识图谱（不接 Neo4j 时用 JSON 图谱） ----------
USE_NEO4J=false
GRAPH_PRIMARY=json
GRAPH_SYNC_MODE=sync

# ---------- OCR ----------
# auto：优先本地 RapidOCR，失败回退云端；首次识别会加载模型，约 +300 MB
OCR_PROVIDER=auto

# ---------- 体积与配额（40 GB 盘必须收紧） ----------
SPACE_MAX_FILE_BYTES=20971520
SPACE_MAX_ITEM_COUNT=120
LEARNING_CONTENT_MAX_CHARS=60000

# ---------- 安全 ----------
FLASK_SECRET_KEY=
BACKEND_DEBUG=false
CORS_ALLOWED_ORIGINS=

# 评测接口会批量打模型，低配下保持关闭
AGENT_EVAL_ENABLED=false

# ---------- 限流 ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AGENT_TUTOR=60
RATE_LIMIT_MAX_KEYS=2000

# ---------- 镜像标签 ----------
FZG_TAG=latest
