# ============================================================
# 坊知工 FZG - 云端环境变量示例
# 使用方法：复制为 deploy/.env 后填写（docker compose 会自动读取）
#   cp deploy/.env.example deploy/.env
# 注意：.env 已被 .gitignore 忽略，请勿提交真实密钥
# ============================================================

# ---------- 基础运行 ----------
# 对外端口（Nginx 监听，安全组需放通 80/443）
HOST_PORT=80
# 是否同时拉起 Celery worker（必须已接 RDS；SQLite 下请保持 false）
ENABLE_ASYNC=false
BACKEND_DEBUG=false
BACKEND_USE_RELOADER=false

# 会话/签名密钥，生产必须替换为随机值：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=please-change-me-to-a-random-string
AUTH_TOKEN_TTL_DAYS=14

# ---------- 大模型（华为云 ModelArts Studio / MaaS） ----------
# 说明：智能体链路固定读取 QWEN_* 变量，接入 MaaS 时只需把 QWEN_API_URL
# 指向 MaaS 的 OpenAI 兼容地址，并保持 AI_PROVIDER=qwen 即可。
USE_REAL_AI=true
AI_PROVIDER=qwen
QWEN_API_KEY=
QWEN_API_URL=https://<maas-endpoint>/v1/chat/completions
QWEN_MODEL_NAME=DeepSeek-V3
# 备用：直接使用 DeepSeek 官方接口时改为 AI_PROVIDER=deepseek 并填写以下三项
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL_NAME=deepseek-chat

# 智能体运行时
AGENT_TIMEOUT_SECONDS=50
AGENT_MAX_RETRIES=1
AGENT_ENABLE_GUARD=true
AGENT_HISTORY_BACKEND=auto
# 内存会话上限（Redis 不可达时生效），避免匿名访客导致内存持续增长
AGENT_HISTORY_MAX_SESSIONS=200

# 评测接口默认关闭，避免公网被刷模型额度；本地评测可设 true 或配置 Token
AGENT_EVAL_ENABLED=false
AGENT_EVAL_TOKEN=

# 跨域白名单（逗号分隔）。留空时仅放行 localhost:5000/5501
# 云端同源部署（Nginx 反代）无需配置
CORS_ALLOWED_ORIGINS=

# ---------- OCR ----------
# mock：无需云端，纯文本提问可正常演示；qwen_vl：调用多模态模型识题
OCR_PROVIDER=mock
QWEN_VL_MODEL_NAME=qwen-vl-plus

# ---------- 探索推荐开放资源 ----------
# 只调用官方 API：Wikipedia / Wikibooks 不需要 Key；YouTube 需要官方 Data API v3 Key
WIKIPEDIA_LANGUAGES=zh
OPEN_TEXTBOOKS_ENABLED=1
OPENSTAX_ENABLED=1
OPENSTAX_CATALOG_TTL_SECONDS=86400
OAK_API_KEY=
SERPAPI_API_KEY=
SERPAPI_ENGINES=google_scholar,google_books,google_videos,google_play_books
SERPAPI_MAX_QUERIES=2
YOUTUBE_API_KEY=
OPEN_RESOURCE_TIMEOUT_SECONDS=1.8
OPEN_RESOURCE_CACHE_TTL_SECONDS=21600
OPEN_RESOURCE_MAX_QUERIES=4

# ---------- 关系型数据库（华为云 RDS for MySQL） ----------
# 留空则使用容器内 SQLite（backend/data/fzg.db），仅适合单实例演示
# 云端建议：mysql+pymysql://fzg:<password>@<rds-private-ip>:3306/fzg?charset=utf8mb4
DATABASE_URL=
# 注意：仅有 DATABASE_URL 并不会切换主数据仓储，必须同时设为 sql
# （缺省 json：用户/画像/计划存 backend/data/*.json，仅适合单实例演示）
STORAGE_BACKEND=json
SPACE_STORAGE_BACKEND=sql

# ---------- Redis（华为云 DCS） ----------
# 留空则使用 compose 内置 redis；云端填写 DCS 实例地址（含密码）
# REDIS_URL=redis://:<password>@<dcs-private-ip>:6379/0
REDIS_URL=
AGENT_REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---------- 知识图谱（Neo4j / Aura / ECS 自建） ----------
# auto：配置齐全且可连通时自动启用，否则回落到 JSON 图谱
USE_NEO4J=auto
GRAPH_PRIMARY=auto
GRAPH_SYNC_MODE=auto
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---------- 知识库（RAG-Graph） ----------
KB_PUBLIC_VECTOR_ENABLED=true
KB_PRIVATE_VECTOR_ENABLED=true
KB_PUBLIC_VECTOR_MODEL=BAAI/bge-small-zh-v1.5
# 服务器无法访问 HuggingFace 时使用镜像；镜像内已预下载模型则可设 HF_HUB_OFFLINE=1
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_OFFLINE=false

# ---------- 学习空间上传限制 ----------
SPACE_MAX_FILE_BYTES=10485760
SPACE_MAX_ITEM_COUNT=200
